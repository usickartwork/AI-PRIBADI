# ─── AI Provider API Keys ─────────────────────────────────────────────────────
# Add the API key(s) for the provider(s) you want to use.
# You can enable multiple providers at the same time.
# Only providers with a key will appear in the model dropdown.

# Cloudflare Workers AI — https://dash.cloudflare.com
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Anthropic Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Google Gemini — https://aistudio.google.com
GEMINI_API_KEY=

# Groq — https://console.groq.com
GROQ_API_KEY=

# NVIDIA NIM — https://build.nvidia.com
NVIDIA_API_KEY=

# Ollama Remote Server Endpoint
OLLAMA_API_KEY=
OLLAMA_BASE_URL=

# OpenRouter — https://openrouter.ai
OPENROUTER_API_KEY=

# Cerebras — https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Together AI — https://api.together.ai
TOGETHER_API_KEY=

# HuggingFace — https://huggingface.co/settings/tokens
HF_API_KEY=

# Novita AI (Qwen Models) — https://novita.ai
NOVITA_API_KEY=

# Tavily AI Search API — https://tavily.com
TAVILY_API_KEY=

# Custom API Endpoint (OpenAI-compatible)
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL_NAME=

# ─── Clerk Authentication (Google & Apple Login) ─────────────────────────────
# https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ─── Supabase Authentication & Database ──────────────────────────────────────
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Email Delivery for OTP Verification ──────────────────────────────────
# Pilih salah satu untuk pengiriman kode OTP:
# Opsi 1: Gmail (100% Gratis 500 email/hari, tanpa perlu domain web)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Opsi 2: Resend API Key (https://resend.com/api-keys)
RESEND_API_KEY=

# ─── Supabase Service Role Key (Opsional, untuk bypass RLS saldo) ───────────
SUPABASE_SERVICE_ROLE_KEY=

# ─── Subscription & Credit Limits (Opsional, default otomatis aktif) ────────
# FREE_AI_CREDITS=10000
# FREE_CODE_CREDITS=50
# FREE_SCHEDULE_LIMIT=3
# PRO_AI_CREDITS=100000
# PRO_CODE_CREDITS=200
# PRO_SCHEDULE_LIMIT=50

