# ─── AI Provider API Keys ─────────────────────────────────────────────────────
# Add the API key(s) for the provider(s) you want to use.
# You can enable multiple providers at the same time.
# Only providers with a key will appear in the model dropdown.

# Cloudflare Workers AI — https://dash.cloudflare.com
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Anthropic Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Google Gemini — https://aistudio.google.com
GEMINI_API_KEY=

# Groq — https://console.groq.com
GROQ_API_KEY=

# NVIDIA NIM — https://build.nvidia.com
NVIDIA_API_KEY=

# Ollama Remote Server Endpoint
OLLAMA_API_KEY=
OLLAMA_BASE_URL=

# OpenRouter — https://openrouter.ai
OPENROUTER_API_KEY=

# Cerebras — https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Together AI — https://api.together.ai
TOGETHER_API_KEY=

# HuggingFace — https://huggingface.co/settings/tokens
HF_API_KEY=

# Tavily AI Search API — https://tavily.com
TAVILY_API_KEY=

# Custom API Endpoint (OpenAI-compatible)
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL_NAME=

# ─── Supabase Authentication & Database ──────────────────────────────────────
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Email Delivery for OTP Verification ──────────────────────────────────
# Choose ONE: Resend (Recommended, free 3000 emails/mo) OR Gmail App Password
# Option 1: Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Option 2: Gmail SMTP (Free 500 emails/day)
# Use your Google Account App Password (16 characters), NOT normal password
GMAIL_USER=
GMAIL_APP_PASSWORD=

