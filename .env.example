# ─── AI Provider API Keys ─────────────────────────────────────────────────────
# Add the API key(s) for the provider(s) you want to use.
# You can enable multiple providers at the same time.
# Only providers with a key will appear in the model dropdown.

# Google Gemini — https://aistudio.google.com
# Free tier: very generous, recommended for personal use
GEMINI_API_KEY=

# Groq — https://console.groq.com
# Free tier: Llama 3.3 70B, extremely fast inference
GROQ_API_KEY=

# OpenRouter — https://openrouter.ai
# Free tier: 50+ models including Llama, Gemma, DeepSeek
OPENROUTER_API_KEY=

# Together AI — https://api.together.ai
# Free $1 credit on signup, then pay-as-you-go
TOGETHER_API_KEY=

# HuggingFace Inference Endpoints — https://huggingface.co/settings/tokens
# Free tier: limited rate
HF_API_KEY=
